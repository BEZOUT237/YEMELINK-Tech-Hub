{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "enum": [
        "web-development",
        "mobile-app",
        "graphic-design",
        "content-creation",
        "digital-marketing",
        "copywriting",
        "other"
      ]
    },
    "budget": {
      "type": "string",
      "enum": [
        "< $500",
        "$500 - $1000",
        "$1000 - $5000",
        "$5000+"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in-progress",
        "completed",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "service",
    "message"
  ]
}