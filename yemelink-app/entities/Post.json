{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "Post text content"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "link"
      ],
      "default": "text"
    },
    "media_url": {
      "type": "string",
      "description": "Media attachment URL"
    },
    "link_url": {
      "type": "string",
      "description": "External link if type is link"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "content"
  ]
}